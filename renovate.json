{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["/^oxc_/"],
      "groupName": "oxc"
    },
    {
      "matchPackageNames": ["/^tree-sitter/"],
      "groupName": "tree-sitter"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  }
}
